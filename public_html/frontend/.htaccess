# VEIRONAUTO Frontend .htaccess
# Language detection + static asset serving

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /frontend/
    
    # Permite fișierele reale (CSS, JS, imagini, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # Permite directoarele reale (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Redirecționează rădăcina către index.html cu language detection
    RewriteCond %{REQUEST_URI} ^/frontend/?$
    RewriteRule ^/?$ index.html [L]
    
</IfModule>

# Protecție fișiere sensibile
<FilesMatch "\.(env|php|log|sql)$">
    Deny from all
</FilesMatch>

# Dezactivează dir listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Cache headers pentru assets
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|css|js|svg|ico|woff|woff2|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Compresie
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>
