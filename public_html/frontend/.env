# ================================================
# VEIRONAUTO Environment Configuration
# ================================================
# IMPORTANT: Never commit this file to version control!
# Copy .env.example to .env and fill in your values
# ================================================

# Application Settings
APP_NAME="VEIRONAUTO Car Rental"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Bucharest

# API Configuration
API_VERSION=1.0.0
API_BASE_URL=http://localhost/api/v1

# Database Configuration
DB_HOST=95.217.111.248
DB_PORT=3306
DB_NAME=veironau1_newsite
DB_USER=veironau1_admin
DB_PASS=Veironauto2025!
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Email/SMTP Configuration
SMTP_HOST=mail.veironauto.com
SMTP_PORT=465
SMTP_USERNAME=test@veironauto.com
SMTP_PASSWORD=Veirontest123!
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=test@veironauto.com
SMTP_FROM_NAME="VEIRONAUTO Car Rental"
SMTP_DEBUG=0

# Admin Email
ADMIN_EMAIL=pcdoctor.satumare@gmail.com

# JWT Configuration
JWT_SECRET=veironauto-jwt-secret-key-change-in-production-2025-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp
UPLOAD_PATH=/uploads/

# Rate Limiting (requests per minute)
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_UPLOAD=10

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://veironauto.com,http://localhost:3000,http://localhost:8080
CORS_MAX_AGE=3600

# Currency Configuration
DEFAULT_CURRENCY=EUR
CURRENCY_RATE_EUR_RON=5.0700

# Pagination
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Logging
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_PATH=/logs/

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Security
SECURE_HEADERS=true
XSS_PROTECTION=true
CONTENT_SECURITY_POLICY=false
