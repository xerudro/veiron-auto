{
    "name": "veironauto/car-rental-system",
    "description": "VEIRONAUTO Car Rental Management System",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "VeironAuto\\": "src/"
        }
    },
