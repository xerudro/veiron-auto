# ================================================
# VEIRONAUTO Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your actual values
# ================================================

# Application Settings
APP_NAME="VEIRONAUTO Car Rental"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Bucharest

# API Configuration
API_VERSION=1.0.0
API_BASE_URL=http://localhost/api/v1

# Database Configuration
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Email/SMTP Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Your Company Name"
SMTP_DEBUG=0

# Admin Email
ADMIN_EMAIL=admin@yourdomain.com

# JWT Configuration (Generate a strong random secret!)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp
UPLOAD_PATH=/uploads/

# Rate Limiting (requests per minute)
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_UPLOAD=10

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
CORS_MAX_AGE=3600

# Currency Configuration
DEFAULT_CURRENCY=EUR
CURRENCY_RATE_EUR_RON=5.0700

# Pagination
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Logging
LOG_ENABLED=true
LOG_LEVEL=error
LOG_PATH=/logs/

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Security
SECURE_HEADERS=true
XSS_PROTECTION=true
CONTENT_SECURITY_POLICY=false
