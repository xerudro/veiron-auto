# ================================================
# VEIRONAUTO .gitignore
# ================================================

# Environment Configuration
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
uploads/
!uploads/.gitkeep

# Vendor/Dependencies
vendor/
node_modules/

# IDE/Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary Files
temp/
tmp/
*.tmp
*.cache

# Database
*.sql.gz
database/backups/
!database/schema.sql
!database/seed/

# Security
*.pem
*.key
*.cert
*.p12

# Build Files
dist/
build/
*.min.js
*.min.css

# OS Files
Thumbs.db
.DS_Store
desktop.ini

# PHP
composer.phar
.phpunit.result.cache

# Backup Files
*.bak
*.backup
*~

# Sensitive Data
credentials.json
secrets.json
