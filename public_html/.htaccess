# VEIRONAUTO .htaccess Configuration
# Root routing - Frontend + Backend API

# DirectoryIndex - servește index.html din frontend
DirectoryIndex frontend/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Permite fișierele și directoarele reale
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Public API endpoints - Backend
    RewriteRule ^api/booking/?$ backend/api/public/booking.php [QSA,L]
    RewriteRule ^api/contact/?$ backend/api/public/contact.php [QSA,L]
    RewriteRule ^api/public/booking\.php$ backend/api/public/booking.php [QSA,L]
    RewriteRule ^api/public/contact\.php$ backend/api/public/contact.php [QSA,L]

    # Language routing - friendly URLs
    RewriteRule ^en/?$ frontend/index-en.html [L]
    RewriteRule ^ro/?$ frontend/index-ro.html [L]

    # Frontend routing - redirect la frontend/index.html cu language detection
    # EXCLUDE explicit paths
    RewriteCond %{REQUEST_URI} !^/(backend|api|config|database|logs|vendor|optimization-journey|\.well-known)/
    RewriteCond %{REQUEST_URI} !^/\.
    RewriteRule ^(.*)$ frontend/index.html [L]
</IfModule>

# Protecție fișiere sensibile
<FilesMatch "\.(env|log|sql|tmp)$">
    Deny from all
</FilesMatch>

# Specific: blochează config și secret JSON files
<Files "config.json">
    Deny from all
</Files>
<Files "secrets.json">
    Deny from all
</Files>
<Files "settings.json">
    Deny from all
</Files>

# Dezactivează dir listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Cache headers
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|css|js|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# Compresie
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
